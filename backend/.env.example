# Preenchido automaticamente pelo Railway quando você adiciona o addon PostgreSQL.
# Localmente, deixe em branco para usar um arquivo SQLite (local.db).
DATABASE_URL=

# Domínio do frontend publicado no Vercel, para liberar o CORS.
# Pode listar múltiplos separados por vírgula. Use "*" apenas em desenvolvimento.
ALLOWED_ORIGINS=*
